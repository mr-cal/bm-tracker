# Local development configuration. Copy to .env and adjust as needed.
#
# Production does NOT use this file. The container is given real environment
# variables by `env_file: bm-tracker.env` in the vps-infra compose file, and
# those take precedence over anything here.
#
# Every value here is a placeholder. gitleaks allowlists this path so that
# scanning it does not report the placeholders as leaked secrets.

# "development" relaxes the production guards on SESSION_SECRET and DEBUG.
# The container must be left as "production".
APP_ENV=development

# The app is async, so this is the ASYNC driver. The alembic environment strips
# +aiosqlite to reach the synchronous one for migrations.
DATABASE_URL=sqlite+aiosqlite:///./data/bm_tracker.db

# Signs the session cookie. Any 32+ random bytes, e.g. `openssl rand -hex 32`.
# Required when APP_ENV=production; ignored in development.
SESSION_SECRET=

SESSION_MAX_AGE_DAYS=30
QUICK_ENTRY_WINDOW_MINUTES=10

DEBUG=false
LOG_LEVEL=INFO

# Note achievements. The only thing in the app that calls a provider, and it is
# switched off without a key. Prototypes are embedded once and cached, so this
# costs one call per note that carries text.
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1024
